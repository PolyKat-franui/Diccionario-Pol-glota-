rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esCreadora() {
      return request.auth != null && request.auth.token.email == 'fransanhueza206@gmail.com' && request.auth.token.email_verified == true;
    }
    // Avance de cada persona: solo ella lo lee y lo escribe.
    match /progreso/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ranking: lo ve quien inició sesión; cada persona escribe solo su fila,
    // y solo con nombre y números (nunca el correo).
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'racha', 'dia', 'palabras', 'nivel', 'actualizado', 'liga', 'semana', 'xp'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30
        && request.resource.data.racha is int && request.resource.data.racha >= 0 && request.resource.data.racha < 100000
        && request.resource.data.dia is string && request.resource.data.dia.size() <= 10
        && request.resource.data.palabras is int && request.resource.data.palabras >= 0 && request.resource.data.palabras < 1000000
        && request.resource.data.nivel is int && request.resource.data.nivel >= 0 && request.resource.data.nivel < 1000
        && request.resource.data.actualizado is int
        && (!('liga' in request.resource.data) || (request.resource.data.liga is int && request.resource.data.liga >= 0 && request.resource.data.liga < 4))
        && (!('semana' in request.resource.data) || (request.resource.data.semana is string && request.resource.data.semana.size() <= 8))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 100000));
    }
    // Buzón de sugerencias: cualquiera envía (con o sin cuenta); solo la creadora lee, marca y borra.
    match /sugerencias/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto', 'fecha', 'idioma', 'version', 'leida', 'nombre', 'uid'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.fecha is int
        && request.resource.data.idioma is string && request.resource.data.idioma.size() <= 5
        && request.resource.data.version is string && request.resource.data.version.size() <= 12
        && request.resource.data.leida == false
        && (!('nombre' in request.resource.data) || (request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30))
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if esCreadora();
      allow update: if esCreadora() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
    }
  }
}
